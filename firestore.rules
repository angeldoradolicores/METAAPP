rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Posts — públicos para lectura, solo admin con auth puede escribir
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;

      // Comentarios — cualquiera puede leer y crear; admin puede eliminar
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() < 1000;
        allow delete: if request.auth != null;
      }
    }

    // Mensajes — cualquiera puede crear; solo admin puede leer/actualizar
    match /messages/{messageId} {
      allow create: if request.resource.data.body is string
                    && request.resource.data.body.size() > 0;
      allow read, update, delete: if request.auth != null;
    }

    // Config (logo, etc.) — público para leer; solo admin puede escribir
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
